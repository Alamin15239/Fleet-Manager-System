# Database
DATABASE_URL="file:./dev.db"

# Authentication - REQUIRED FOR SECURITY
JWT_SECRET="your-super-secure-32-character-secret-key-here-change-this"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-nextauth-secret-key-change-this-too"

# Optional Google OAuth sign-in / signup (Google Cloud OAuth web client)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Email Service (Resend)
RESEND_API_KEY="your-resend-api-key"
EMAIL_FROM="Fleet Manager <noreply@fleetmanager.space>"
RESEND_DOMAIN="fleetmanager.space"

# App Configuration
NEXT_PUBLIC_APP_URL="http://localhost:3000"
CRON_SECRET=""

# Annual organization subscriptions
# Select TAP or PADDLE. Leave as TAP unless you are ready to switch providers.
ORGANIZATION_PAYMENT_PROVIDER="TAP"
# Tap Payments
# Set TAP_RECURRING_ENABLED=true only after Tap enables Save Card/recurring
# payments and merchant-initiated transactions on your production account.
TAP_SECRET_KEY=""
TAP_MERCHANT_ID=""
TAP_RECURRING_ENABLED="false"
ORGANIZATION_ANNUAL_PRICE_SAR="4800"
# Sandbox only while Paddle account verification is pending or declined.
# Use a sandbox API key, test_ client token, sandbox price, and sandbox webhook secret.
# Live Paddle API calls and webhook handling are disabled in this code.
PADDLE_ENVIRONMENT="sandbox"
PADDLE_API_KEY=""
PADDLE_CLIENT_TOKEN=""
PADDLE_PRICE_ID=""
PADDLE_WEBHOOK_SECRET=""

# Optional OneDrive Excel export configuration
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_TOKEN_ENCRYPTION_KEY=""

# Real-time Sync
SYNC_ENABLED="true"
PRODUCTION_URL="https://fleetmanager.space"
VERCEL_TOKEN="your-vercel-token"

# Optional: AI Features
OPENAI_API_KEY="your-openai-api-key"

# Vercel Analytics & Speed Insights
NEXT_PUBLIC_VERCEL_ANALYTICS_ID="your-vercel-analytics-id"
VERCEL_ANALYTICS_ID="your-vercel-analytics-id"

# SMTP Configuration (Alternative to REST API)
SMTP_HOST="smtp.resend.com"
SMTP_PORT="465"
SMTP_USER="resend"
SMTP_PASSWORD="your-resend-api-key"
